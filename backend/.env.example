# Server Configuration
PORT=3001
API_PREFIX=v1
ADMIN_API_TOKEN=sava-admin-secret-token-2026

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sava_live_gallery
DB_SYNCHRONIZE=true

# Redis (BullMQ & Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# FTP Bridge Server
FTP_ENABLED=true
FTP_HOST=0.0.0.0
FTP_PORT=2121
FTP_PASV_URL=127.0.0.1
FTP_PASV_MIN=50000
FTP_PASV_MAX=50100
FTP_TEMP_DIR=./temp-ftp

# Cloudflare R2 (S3-Compatible Storage) & CDN
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sava-live-bucket
R2_PRESIGNED_EXPIRES_IN=300
CDN_BASE_URL=https://cdn.domainanda.com
